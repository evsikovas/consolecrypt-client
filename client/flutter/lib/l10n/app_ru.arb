  "rdpMobileHelp": "\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b \u2014 \u044d\u0442\u043e \u0442\u0430\u0447\u043f\u0430\u0434. \u0412\u043e\u0434\u0438\u0442\u0435 \u043e\u0434\u043d\u0438\u043c \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u0434\u043b\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043a\u0443\u0440\u0441\u043e\u0440\u0430; \u043f\u0430\u043b\u0435\u0446 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0442\u044c \u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c.\n\n\u041a\u0430\u0441\u0430\u043d\u0438\u0435 \u2014 \u043b\u0435\u0432\u044b\u0439 \u043a\u043b\u0438\u043a, \u0434\u0432\u0430 \u0431\u044b\u0441\u0442\u0440\u044b\u0445 \u043a\u0430\u0441\u0430\u043d\u0438\u044f \u2014 \u0434\u0432\u043e\u0439\u043d\u043e\u0439. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0432\u0442\u043e\u0440\u043e\u0435 \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u0438 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435 \u043f\u0430\u043b\u0435\u0446 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u043d\u0438\u044f. \u041c\u043e\u0436\u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043e\u0434\u0438\u043d \u043f\u0430\u043b\u0435\u0446 \u043e\u043a\u043e\u043b\u043e \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b \u0441\u0435\u043a\u0443\u043d\u0434\u044b, \u0437\u0430\u0442\u0435\u043c \u0434\u0432\u0438\u0433\u0430\u0442\u044c.\n\n\u0414\u0432\u0430 \u043f\u0430\u043b\u044c\u0446\u0430: \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u2014 \u043f\u0440\u0430\u0432\u044b\u0439 \u043a\u043b\u0438\u043a, \u043f\u0430\u0440\u0430\u043b\u043b\u0435\u043b\u044c\u043d\u043e\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u2014 \u043f\u0440\u043e\u043a\u0440\u0443\u0442\u043a\u0430, \u0449\u0438\u043f\u043e\u043a \u2014 \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u043e\u0442 1\u00d7 \u0434\u043e 4\u00d7. \u0414\u0432\u043e\u0439\u043d\u043e\u0435 \u043a\u0430\u0441\u0430\u043d\u0438\u0435 \u0434\u0432\u0443\u043c\u044f \u043f\u0430\u043b\u044c\u0446\u0430\u043c\u0438 \u0432\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443 \u0432 \u044d\u043a\u0440\u0430\u043d. \u041f\u0440\u0438 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0437\u0430 \u043a\u0443\u0440\u0441\u043e\u0440\u043e\u043c.\n\n\u041a\u0430\u0441\u0430\u043d\u0438\u0435 \u0442\u0440\u0435\u043c\u044f \u043f\u0430\u043b\u044c\u0446\u0430\u043c\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0438\u043b\u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0443. \u041e\u043d\u0430 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443, \u0430 \u043d\u0435 \u0441\u0436\u0438\u043c\u0430\u0435\u0442 \u0435\u0451. \u0412 \u043f\u0430\u043d\u0435\u043b\u0438 \u00ab\u041a\u043b\u0430\u0432\u0438\u0448\u0438\u00bb \u043e\u0434\u043d\u043e \u043a\u0430\u0441\u0430\u043d\u0438\u0435 Ctrl, Alt, Win \u0438\u043b\u0438 Shift \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u043a\u043b\u0430\u0432\u0438\u0448\u0443, \u0434\u0432\u043e\u0439\u043d\u043e\u0435 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442, \u0435\u0449\u0451 \u043e\u0434\u043d\u043e \u043e\u0442\u043f\u0443\u0441\u043a\u0430\u0435\u0442.\n\n\u041a\u0440\u0443\u0433\u043b\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043c\u0435\u043d\u044e. \u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0435\u0451 \u043a \u043a\u0440\u0430\u044e \u044d\u043a\u0440\u0430\u043d\u0430. \u0417\u0434\u0435\u0441\u044c \u043c\u043e\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0442\u0430\u0447\u043f\u0430\u0434 \u043d\u0430 \u043f\u0440\u044f\u043c\u043e\u0435 \u043a\u0430\u0441\u0430\u043d\u0438\u0435, \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440, \u0441\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0435\u0430\u043d\u0441 \u0438\u043b\u0438 \u0441\u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0435\u0433\u043e. \u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u0430\u044f \u043c\u044b\u0448\u044c \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e.",
  "localAiTitle": "\u0412\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0418\u0418",
