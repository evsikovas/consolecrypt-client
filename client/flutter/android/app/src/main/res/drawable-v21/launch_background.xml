<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12 (12+ shows the launcher icon): the brand
     mark from tool/render_brand.dart on the same dark background as iOS. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
