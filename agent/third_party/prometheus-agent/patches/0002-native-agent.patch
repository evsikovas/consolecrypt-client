+// hardRetryBounds uses nanosecond-inclusive bounds. Retry-After is a lower
+// bound, not the exponential base: a receiver may require more than one second.
+func hardRetryBounds(base, retryAfter time.Duration) (time.Duration, time.Duration, error) {
+	if base <= 0 || base > time.Second {
+		return 0, 0, wlog.ErrHardModeUnavailable
+	}
+	if retryAfter > 0 {
+		span := base / 2
+		if retryAfter > time.Duration(math.MaxInt64)-span {
+			return 0, 0, wlog.ErrHardModeUnavailable
+		}
+		return retryAfter, span, nil
+	}
+	low := (base + 1) / 2
+	return low, base - low, nil
+}
+
+// hardRetryDelay accepts an already uniformly bounded draw, so arithmetic can
+// be tested without replacing or seeding the process-wide maintained RNG.
+func hardRetryDelay(base, retryAfter time.Duration, draw uint64) (time.Duration, error) {
+	low, span, err := hardRetryBounds(base, retryAfter)
+	if err != nil || draw > uint64(span) {
+		return 0, wlog.ErrHardModeUnavailable
+	}
+	return low + time.Duration(draw), nil
+}
+
+func hardNextRetryBase(base, maximum time.Duration) time.Duration {
+	if base >= maximum-base {
+		return maximum
+	}
+	return base * 2
+}
+
+func (t *QueueManager) hardRetryCurrent(ctx context.Context, generation <-chan struct{}) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	select {
+	case <-generation:
+		return wlog.ErrHardModeUnavailable
+	default:
+	}
+	if !t.hard.Ready() {
+		return wlog.ErrHardModeUnavailable
+	}
+	return nil
+}
+
+// The original shard context and original native generation both cancel this
+// wait. A later Resume cannot renew an already captured retry lifetime.
+func (t *QueueManager) waitHardRetry(ctx context.Context, generation <-chan struct{}, delay time.Duration) error {
+	if err := t.hardRetryCurrent(ctx, generation); err != nil {
+		return err
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-generation:
+		return wlog.ErrHardModeUnavailable
+	case <-timer.C:
+		return t.hardRetryCurrent(ctx, generation)
+	}
+}
+
+func (t *QueueManager) sendHardWriteRequestWithBackoff(ctx context.Context, attempt func(int) error, onRetry func()) error {
+	base, maximum := time.Duration(t.cfg.MinBackoff), time.Duration(t.cfg.MaxBackoff)
+	if base <= 0 || maximum < base || maximum > time.Second {
+		return wlog.ErrHardModeUnavailable
+	}
+	generation, err := t.hard.RetryDone()
+	if err != nil {
+		return err
+	}
+	for tries := 0; ; tries++ {
+		if err := t.hardRetryCurrent(ctx, generation); err != nil {
+			return err
+		}
+		err := attempt(tries)
+		if err == nil {
+			return nil
+		}
+		var recoverable RecoverableError
+		if !errors.As(err, &recoverable) {
+			return err
+		}
+        retryAfter := time.Duration(recoverable.retryAfter)
+        var hint *hardRetryAfterHint
+        if errors.As(recoverable.error, &hint) {
+            if hint.invalid {
+                t.hard.Fail()
+                return wlog.ErrHardModeUnavailable
+            }
+            retryAfter = max(retryAfter, hint.minimum)
+        }
+		_, span, boundsErr := hardRetryBounds(base, retryAfter)
+		if boundsErr != nil {
+			t.hard.Fail()
+			return boundsErr
+		}
+		delay, boundsErr := hardRetryDelay(base, retryAfter, rand.Uint64N(uint64(span)+1))
+		if boundsErr != nil {
+			t.hard.Fail()
+			return boundsErr
+		}
+		// Saturate only this advisory resharding window; never truncate a
+		// receiver's Retry-After or overflow a doubled duration.
+		window := min(delay, time.Duration(math.MaxInt64/2)) * 2
+		if oldTS, updated := setAtomicToNewer(&t.reshardDisableEndTimestamp, time.Now().Add(window).Unix()); updated {
+			if now := time.Now().Unix(); oldTS < now {
+				t.reshardDisableStartTimestamp.Store(now)
+			}
+		}
+		if err := t.waitHardRetry(ctx, generation, delay); err != nil {
+			return err
+		}
+		if err := t.hardRetryCurrent(ctx, generation); err != nil {
+			return err
+		}
+		onRetry()
+		t.logger.Warn("Failed to send batch, retrying", "err", err)
+		base = hardNextRetryBase(base, maximum)
+	}
+}
