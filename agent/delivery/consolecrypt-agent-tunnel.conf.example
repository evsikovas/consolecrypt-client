# EXAMPLE ONLY. Never installed, loaded or enabled by the package/roles.
# Replace documentation-only 203.0.113.10 with the explicitly approved Relay IP.
# Do not copy this file unchanged into systemd configuration.
[Service]
ExecStart=
ExecStart=/usr/bin/python3 -I /opt/consolecrypt-agent/launch.py --manifest /etc/consolecrypt-agent/manifest.json --identity-config /etc/consolecrypt-agent/identity-config.json --state-dir /var/lib/consolecrypt-agent/history --tunnel-config /etc/consolecrypt-agent/tunnel.json
IPAddressAllow=203.0.113.10
# Bounded outer grace for sequential sampler/carrier/Reader/worker owner joins.
# This does not renew a Relay, Node, Reader or authorization deadline.
TimeoutStopSec=30s
