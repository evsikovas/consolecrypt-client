[Unit]
Description=ConsoleCrypt independent Prometheus monitoring node
After=network.target
RequiresMountsFor=/srv/consolecrypt-monitoring

[Service]
User=cc-monitoring
Group=cc-monitoring
ExecStart=/opt/consolecrypt-monitoring/prometheus-3.16.0.linux-amd64/prometheus --config.file=/etc/consolecrypt-monitoring/prometheus.yml --storage.tsdb.path=/srv/consolecrypt-monitoring/data --storage.tsdb.retention.time={{ cc_monitoring_plan.retention_days }}d --storage.tsdb.retention.size={{ cc_monitoring_plan.retention_gib }}GB --web.listen-address=127.0.0.1:9090 --web.max-connections=64 --query.max-concurrency=4{{ ' --web.enable-remote-write-receiver' if cc_monitoring_plan.receiver_enabled else '' }}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/consolecrypt-monitoring/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
MemoryMax={{ cc_monitoring_plan.memory_mib }}M
CPUQuota={{ cc_monitoring_plan.cpu_cores | int * 100 }}%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
