#!/usr/bin/python3 -I
"""Fixed installed enrollment adapter. No caller-selected path or command."""
import grp
import os
from pathlib import Path
import pwd
import stat
import sys


def require(value, code):
    if not value:
        raise ValueError(code)


def trusted(path, regular=False, cap=1048576):
    path = Path(path)
    for item in (path, *path.parents):
        info = item.lstat()
        require(info.st_uid == 0 and not info.st_mode & 0o022,
                "root_nonwrite_required")
        require(stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode), "physical_path_required")
        if stat.S_ISREG(info.st_mode):
            require(info.st_nlink == 1, "singlelink_required")
        if item != path:
            require(stat.S_ISDIR(info.st_mode), "directory_parent_required")
    info = path.lstat()
    if regular:
        require(stat.S_ISREG(info.st_mode) and info.st_size <= cap, "bounded_regular_required")
    return path


def read_root(path, cap=1048576):
    path = trusted(path, regular=True, cap=cap)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        def identity(info):
            return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
                    info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
        actual = os.fstat(fd)
        require(stat.S_ISREG(actual.st_mode) and actual.st_uid == 0 and
                not actual.st_mode & 0o022 and actual.st_nlink == 1 and
                0 <= actual.st_size <= cap, "held_root_regular_required")
        # Repeat physical/root-controlled ancestry after opening and before data.
        trusted(path, regular=True, cap=cap)
        require(identity(path.lstat()) == identity(actual), "held_path_identity_required")
        data = bytearray()
        while len(data) <= cap:
            part = os.read(fd, min(65536, cap + 1 - len(data)))
            if not part:
                break
            data.extend(part)
        trusted(path, regular=True, cap=cap)
        require(len(data) == actual.st_size and
                identity(os.fstat(fd)) == identity(actual) == identity(path.lstat()),
                "stable_complete_root_input_required")
        return bytes(data)
    finally:
        os.close(fd)


def service():
    user = pwd.getpwnam("consolecrypt-agent")
    group = grp.getgrnam("consolecrypt-agent")
    require(user.pw_uid > 0 and user.pw_gid == group.gr_gid > 0, "service_identity_required")
    require(user.pw_shell in ("/usr/sbin/nologin", "/sbin/nologin"), "service_nologin_required")
    return user, group


def main():
    require(sys.argv[1:] == [], "zero_arguments_required")
    trusted(__file__, regular=True)
    user, group = service()
    require(os.getuid() == os.geteuid() == user.pw_uid and
            os.getgid() == os.getegid() == group.gr_gid, "service_runas_required")
    runtime = Path("/etc/consolecrypt-agent/managed-exporter-runtime.json")
    if runtime.exists() or runtime.is_symlink():
        # This separate explicit root preparation changes transport/resources,
        # never owner/Node permission. Unknown opt-in never falls back to SSH.
        import hashlib
        import json
        bridge = Path("/usr/local/libexec/consolecrypt-agent-managed-exporter/enrollment_bridge.py")
        def unique(pairs):
            value = {}
            for key, item in pairs:
                require(key not in value, "managed_runtime_duplicate")
                value[key] = item
            return value
        config = json.loads(read_root(runtime, 4096), object_pairs_hook=unique)
        require(type(config) is dict and set(config) == {"format", "serviceUid", "serviceGid", "bridgeSha256"}
                and config["format"] == "cc-agent-managed-exporter-control/v1"
                and type(config["serviceUid"]) is int and config["serviceUid"] == user.pw_uid
                and type(config["serviceGid"]) is int and config["serviceGid"] == group.gr_gid,
                "managed_runtime_identity")
        source = read_root(bridge, 65536)
        require(hashlib.sha256(source).hexdigest() == config["bridgeSha256"], "managed_runtime_bridge")
        namespace = {"__name__": "owned_managed_exporter_bridge", "__file__": str(bridge)}
        exec(compile(source, str(bridge), "exec"), namespace)
        namespace["relay_original"](user.pw_uid)
        return
    trusted("/opt/consolecrypt-agent-install/opt/consolecrypt-agent/launch.py", regular=True)
    trusted(Path("/usr/bin/python3").resolve(strict=True), regular=True, cap=64 * 1024 * 1024)
    os.execve("/usr/bin/python3", ["/usr/bin/python3", "-I", "-B",
              "/opt/consolecrypt-agent-install/opt/consolecrypt-agent/launch.py", "--enrollment-worker"], {"LANG": "C.UTF-8"})


if __name__ == "__main__":
    try:
        main()
    except (OSError, KeyError, ValueError):
        sys.exit(1)
