[Unit]
Description=ConsoleCrypt monitoring Agent (independent machine identity)
After=network.target
ConditionPathExists=/etc/consolecrypt-agent/manifest.json
ConditionPathExists=/etc/consolecrypt-agent/identity-config.json

[Service]
Type=simple
DynamicUser=no
User=consolecrypt-agent
Group=consolecrypt-agent
WorkingDirectory=/opt/consolecrypt-agent
ExecStart=/usr/bin/python3 -I /opt/consolecrypt-agent/launch.py --manifest /etc/consolecrypt-agent/manifest.json --identity-config /etc/consolecrypt-agent/identity-config.json --state-dir /var/lib/consolecrypt-agent/history
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077
StateDirectory=consolecrypt-agent/history consolecrypt-agent/identity consolecrypt-agent/checkpoints
StateDirectoryMode=0700
RuntimeDirectory=consolecrypt-agent
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd/containerd.sock
MemoryMax=256M
CPUQuota=25%
TasksMax=16
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
